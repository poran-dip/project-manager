# Database. Local dev uses a SQLite file; production uses a Turso URL.
DATABASE_URL=file:local.db
# Turso auth token. Empty for local file databases.
DATABASE_AUTH_TOKEN=

# Better Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric GitHub user IDs allowed to sign in, comma-separated.
ADMIN_GITHUB_IDS=
